---
import { navItems } from '~types/site';
const { pathname } = Astro.url;
---

<header
  class="fixed top-1/2 right-0 left-0 z-10 flex -translate-y-1/2 items-center justify-center px-30 md:justify-between"
  transition:animate="none"
>
  <p class="md:text-16a hidden md:block">Theo</p>
  <ul class="flex justify-center gap-21">
    {
      navItems.map((item) => (
        <li>
          <a
            class:list={['text-13', pathname === item.href ? 'opacity-50' : 'opacity-100']}
            href={item.href}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="md:text-16a hidden md:block">Lume</p>
</header>

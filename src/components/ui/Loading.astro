---
import { Image } from 'astro:assets';

import LoadingImage from '@assets/img-loading.jpg';
---

<div id="loading" class="fixed inset-0 z-9999">
  <div class="loading-bg loading-exit absolute inset-0 bg-black"></div>
  <div class="relative flex h-screen items-center overflow-hidden px-30">
    <div class="flex w-full items-center justify-between">
      <span class="loading-text-mask">
        <p class="loading-item loading-text text-14b font-bold">
          Photographer<br class="block md:hidden" />PortFolio
        </p>
      </span>
      <span class="loading-image-mask">
        <Image
          src={LoadingImage}
          alt=""
          width={128}
          height={129}
          class="loading-item loading-image h-62 w-69 md:h-129 md:w-128"
        />
      </span>
    </div>
  </div>
</div>

<script>
  // astro:page-loadは初期表示・ClientRouterでのページ遷移のどちらでも発火するため、
  // スクリプトの再実行に頼らずページ遷移のたびにこの判定を行える
  document.addEventListener('astro:page-load', () => {
    const screenEl = document.getElementById('loading');
    if (!screenEl) return;

    const html = document.documentElement;

    if (sessionStorage.getItem('loading-shown')) {
      // 表示済みなら即座に片付ける
      screenEl.remove();
      return;
    }

    // 初期画面で1回だけ表示するため、セッション内で表示済みであることを記録する
    sessionStorage.setItem('loading-shown', '1');

    // ローディング中は背面のスクロールを止める
    html.classList.add('overflow-hidden');

    const bgEl = screenEl.querySelector<HTMLElement>('.loading-bg');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const remove = () => {
      screenEl.remove();
      html.classList.remove('overflow-hidden');
    };

    if (prefersReducedMotion || !bgEl) {
      // reduced-motion時はCSSアニメーションが無く animationend が発火しないためタイマーで対応
      setTimeout(remove, 800);
    } else {
      // テキスト・画像(コンテンツ)と背景(screen-rise)は別レイヤーで独立してアニメーションするため、
      // 両方のanimationendを待ってから消す
      let itemsDone = false;
      let bgDone = false;
      const tryRemove = () => {
        if (itemsDone && bgDone) remove();
      };

      const items = screenEl.querySelectorAll('.loading-item');
      let doneCount = 0;
      items.forEach((item) => {
        item.addEventListener('animationend', () => {
          doneCount += 1;
          if (doneCount === items.length) {
            itemsDone = true;
            tryRemove();
          }
        });
      });

      bgEl.addEventListener('animationend', (event: AnimationEvent) => {
        if (event.target !== bgEl) return;
        bgDone = true;
        tryRemove();
      });
    }
  });
</script>

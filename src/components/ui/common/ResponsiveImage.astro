---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  mobileSrc: ImageMetadata;
  desktopSrc: ImageMetadata;
  alt: string;
  breakpoint?: number;
  class?: string;
  imgClass?: string;
}

const { mobileSrc, desktopSrc, alt, breakpoint = 768, class: className, imgClass } = Astro.props;

const mobileImage = await getImage({
  src: mobileSrc,
  format: 'webp',
  widths: [375, 767],
});

const desktopImage = await getImage({
  src: desktopSrc,
  format: 'webp',
  widths: [768, 1440],
});

const fallbackImage = await getImage({
  src: desktopSrc,
  format: 'jpg',
  width: 1280,
});
---

<picture class={className}>
  <source media={`(min-width: ${breakpoint}px)`} srcset={desktopImage.src} type="image/webp" />
  <source srcset={mobileImage.src} type="image/webp" />
  <img src={fallbackImage.src} alt={alt} loading="lazy" decoding="async" class={imgClass} />
</picture>

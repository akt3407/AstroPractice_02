---
import '@styles/global.css';
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import '@fontsource-variable/arimo/wght.css';

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
}

const { title, description, mainClass = '' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="text-gray bg-black">
    <Header />
    <main
      class={`grid h-svh grid-cols-4 gap-x-20 px-20 pt-20 md:grid-cols-12 md:px-30 md:py-30 ${mainClass}`}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import '@styles/global.css';
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import '@fontsource-variable/arimo/wght.css';
import Loading from '@/components/ui/Loading.astro';

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
}

const { title, description, mainClass = '' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <script is:inline>
      // セッション内で表示済みなら、bodyの描画前にLoadingを隠すクラスを付けてちらつきを防ぐ
      if (sessionStorage.getItem('loading-shown')) {
        document.documentElement.classList.add('loading-skip');
      }
    </script>
  </head>
  <body class="text-gray bg-black">
    <Loading />
    <Header />
    <main
      class={`grid h-svh grid-cols-4 gap-x-20 px-20 pt-20 md:grid-cols-12 md:px-30 md:py-30 ${mainClass}`}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import Lenis from 'lenis';

  const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const lenis = new Lenis({
      autoRaf: true,
      duration: 1.5,
      lerp: 0.12,
      smoothWheel: true,
      syncTouch: false,
      wheelMultiplier: 0.8,
    });

    (window as unknown as { lenis: Lenis }).lenis = lenis;
  }
</script>

---
import WorkDescription from '@/components/ui/works/WorkDescription.astro';
import WorkImage from '@/components/ui/works/WorkImage.astro';
import Layout from '@layouts/Layout.astro';
import PageTitle from '@ui/common/PageTitle.astro';
import { items, workImages } from '@/data/worksItems';
---

<Layout
  title="Works | Photographer Portfolio"
  description="仮想写真家のポートフォリオサイトです"
  mainClass="content-start"
>
  <PageTitle title="Works" />
  {
    items.map((it) =>
      it.type === 'img' ? (
        <WorkImage
          src={workImages[it.imgIndex]}
          title={it.title}
          year={it.year}
          class={it.cls}
          imgClass={it.imgClass}
          modalImgClass={it.modalImgClass}
        />
      ) : (
        <WorkDescription title={it.title} description={it.body} class={it.cls} />
      ),
    )
  }
</Layout>
